<Window x:Class="WpfApp48.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кликер: противники и бонусы" Height="500" Width="820">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="EnemyNameText" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="HealthText" FontSize="20" Margin="0,10,0,0"/>
            <TextBlock x:Name="GoldText" FontSize="18" Margin="0,22,0,0"/>
            <TextBlock x:Name="DamageText" FontSize="18"/>
            <TextBlock x:Name="CooldownText" FontSize="18"/>
            <TextBlock x:Name="BoostText" FontSize="16"/>
            <Button x:Name="UpgradeDamageButton" Click="UpgradeDamageButton_Click"
                    Margin="0,16,12,0" Padding="12,8"/>
            <Button x:Name="UpgradeCooldownButton" Click="UpgradeCooldownButton_Click"
                    Margin="0,8,12,0" Padding="12,8"/>
            <Button x:Name="UpgradeGoldSphereButton"
        Click="UpgradeGoldSphereButton_Click"
        Margin="0,8,12,0"
        Padding="12,8"/>

            <Button x:Name="UpgradeCooldownSphereButton"
        Click="UpgradeCooldownSphereButton_Click"
        Margin="0,8,12,0"
        Padding="12,8"/>

            <TextBlock Margin="0,20,12,0" TextWrapping="Wrap"
                       Text="Сферы: красная — урон x2 на 10 с; голубая — перезарядка -0,1 с и сокращает перезарядку; золотая — добавляет золото. Нажимайте на сферы в области противника. Нажимайте на сферы в области противника."/>
        </StackPanel>

        <Grid Grid.Column="1" Width="280" Height="280" VerticalAlignment="Center"
              HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="GameArea_MouseLeftButtonDown">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Background="#FFF3F3F3"/>
            <Image x:Name="EnemyImage" Margin="24" Stretch="Uniform" IsHitTestVisible="False"/>
            <Canvas x:Name="BonusCanvas" Background="Transparent" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
