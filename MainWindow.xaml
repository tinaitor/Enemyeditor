<Window x:Class="Enemyeditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enemy editor" Height="650" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--иконки -->
        <DockPanel Grid.Column="0" Margin="5">
            <Button DockPanel.Dock="Top"
                    Content="Выбрать папку с иконками"
                    Click="SelectFolder_Click"
                    Margin="0,0,0,5"/>
            <ListBox x:Name="IconsListBox">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <!--противники -->
        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="Имя:"/>
            <TextBox x:Name="NameTextBox"/>

            <TextBlock Text="Здоровье:"/>
            <TextBox x:Name="HealthTextBox"/>

            <TextBlock Text="Урон:"/>
            <TextBox x:Name="DamageTextBox"/>

            <TextBlock Text="Золото:"/>
            <TextBox x:Name="SpeedTextBox"/>

            <Button Content="Добавить противника"
                    Click="AddEnemy_Click" Margin="0,5"/>
            <Button Content="Удалить выбранного"
                    Click="RemoveEnemy_Click" Margin="0,5"/>

            <Button Content="Сохранить в JSON"
                    Click="SaveButton_Click" Margin="0,5"/>
            <Button Content="Загрузить из JSON"
                    Click="LoadButton_Click" Margin="0,5"/>

            <ListBox x:Name="EnemiesListBox" Height="150"
                     SelectionChanged="EnemiesListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon.ImagePath}"
                                   Width="32" Height="32"/>
                            <TextBlock Text="{Binding Name}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Статы выбранного противника -->
            <Border BorderBrush="Gray" BorderThickness="1"
                    Margin="0,10,0,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Характеристики выбранного:"
                               FontWeight="Bold" FontSize="16"
                               Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="SelectedIconImage"
                               Width="96" Height="96"
                               Stretch="Uniform"/>
                        <TextBlock x:Name="SelectedNameText"
                                   Margin="12,0,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="SelectedHealthText"
                               FontSize="8" Margin="0,10,0,0"/>
                    <TextBlock x:Name="SelectedDamageText"
                               FontSize="8" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SelectedSpeedText"
                               FontSize="8" Margin="0,4,0,0"/>

                    <Button x:Name="OpenImageButton"
                            Content="Открыть изображение"
                            Click="OpenImage_Click"
                            Margin="0,10,0,0"
                            IsEnabled="False"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>