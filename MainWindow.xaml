<Window x:Class="Enemyeditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enemy editor" Height="500" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="5">
            <Button DockPanel.Dock="Top"
                    Content="Выбрать папку с иконками"
                    Click="SelectFolder_Click"
                    Margin="0,0,0,5"/>
            <ListBox x:Name="IconsListBox">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DockPanel>

        <StackPanel Grid.Column="1" Margin="5">
            <TextBlock Text="Имя:"/>
            <TextBox x:Name="NameTextBox"/>

            <TextBlock Text="Здоровье:"/>
            <TextBox x:Name="HealthTextBox"/>

            <TextBlock Text="Урон:"/>
            <TextBox x:Name="DamageTextBox"/>

            <TextBlock Text="Скорость:"/>
            <TextBox x:Name="SpeedTextBox"/>

            <Button Content="Добавить противника"
                    Click="AddEnemy_Click" Margin="0,5"/>
            <Button Content="Удалить выбранного"
                    Click="RemoveEnemy_Click" Margin="0,5"/>

            <ListBox x:Name="EnemiesListBox" Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon.ImagePath}"
                                   Width="32" Height="32"/>
                            <TextBlock Text="{Binding Name}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>