<Window x:Class="Enemyeditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enemy editor" Height="700" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <Button DockPanel.Dock="Top"
                        Content="Выбрать папку с иконками"
                        Click="SelectFolder_Click"
                        Margin="0,0,0,5"/>
                <ListBox x:Name="IconsListBox">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>

            <Border Grid.Row="1"
                    BorderBrush="Gray" BorderThickness="1"
                    Margin="0,10,0,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Характеристики выбранного:"
                               FontWeight="Bold" FontSize="16"
                               Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="SelectedIconImage"
                               Width="96" Height="96"
                               Stretch="Uniform"/>
                        <TextBlock x:Name="SelectedNameText"
                                   Margin="12,0,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="SelectedHealthText"
                               FontSize="14" Margin="0,10,0,0"/>
                    <TextBlock x:Name="SelectedGoldRewardText"
                               FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SelectedSpawnChanceText"
                               FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SelectedHealthModifierText"
                               FontSize="14" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SelectedGoldModifierText"
                               FontSize="14" Margin="0,4,0,0"/>

                    <Button x:Name="OpenImageButton"
                            Content="Открыть изображение"
                            Click="OpenImage_Click"
                            Margin="0,10,0,0"
                            IsEnabled="False"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Имя:"/>
                <TextBox x:Name="NameTextBox"/>

                <TextBlock Text="Здоровье:"/>
                <TextBox x:Name="HealthTextBox"/>

                <TextBlock Text="Золото:"/>
                <TextBox x:Name="GoldRewardTextBox"/>

                <TextBlock Text="Шанс появления (вес):" Margin="0,6,0,0"/>
                <TextBox x:Name="SpawnChanceTextBox"/>
                <TextBlock Text="Вес, не процент. Реальная вероятность = вес / сумма"
                           Foreground="Gray" FontStyle="Italic"
                           TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"/>

                <TextBlock Text="Множитель здоровья за уровень:" Margin="0,6,0,0"/>
                <TextBox x:Name="HealthModifierTextBox"/>
                <TextBlock
                           Foreground="Gray" FontStyle="Italic"
                           TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0"><Run Text="1.0 — не растёт. 1.2 — +20% к HP за каждую победу. "/><Run Language="ru-ru" Text="Пишем с запятой"/></TextBlock>

                <TextBlock Text="Множитель золота за уровень:" Margin="0,6,0,0"/>
                <TextBox x:Name="GoldModifierTextBox"/>


                <Button Content="Добавить противника"
                        Click="AddEnemy_Click" Margin="0,10,0,0"/>
                <Button Content="Удалить выбранного"
                        Click="RemoveEnemy_Click" Margin="0,5,0,0"/>

                <Button Content="Сохранить в JSON"
                        Click="SaveButton_Click" Margin="0,5,0,0"/>
                <Button Content="Загрузить из JSON"
                        Click="LoadButton_Click" Margin="0,5,0,0"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     x:Name="EnemiesListBox"
                     MinHeight="120"
                     Margin="0,10,0,0"
                     SelectionChanged="EnemiesListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon.ImagePath}"
                                   Width="32" Height="32"/>
                            <TextBlock Text="{Binding Name}"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>